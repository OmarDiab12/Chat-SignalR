@{
    ViewData["Title"] = "Chat";
    var currentUser = ViewBag.UserName as string ?? string.Empty;
}

<div class="container py-4">
    <div class="row">
        <div class="col-12 mb-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="mb-0">Secure Chat</h2>
                    <small class="text-muted">Logged in as <strong>@currentUser</strong></small>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    <button type="submit" class="btn btn-outline-secondary">Logout</button>
                </form>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-4 mb-4 mb-lg-0">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white">
                    Online users
                </div>
                <div class="card-body p-0">
                    <ul id="onlineUsers" class="list-group list-group-flush">
                        <li class="list-group-item text-muted">Loading users...</li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fw-semibold">Conversation</div>
                        <small class="text-muted" id="activeUserLabel">Select a user to start chatting</small>
                    </div>
                    <span class="badge bg-secondary" id="connectionStatus">Connecting...</span>
                </div>
                <div class="card-body d-flex flex-column">
                    <div id="chatHistory" class="flex-grow-1 overflow-auto mb-3" style="max-height: 60vh;"></div>
                    <div class="input-group">
                        <input id="messageInput" type="text" class="form-control" placeholder="Type a message" autocomplete="off" aria-label="Message" />
                        <button class="btn btn-success" id="sendButton" type="button">Send</button>
                    </div>
                    <small class="text-muted mt-2">Messages are exchanged directly between users using SignalR.</small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"
            integrity="sha512-7SRCYIJtR6F8ocwW7UxW6wGKqbSyqREDbfCORCbGLatU0iugBLwyOXpzhkPyHIFdBO0K2VCu57fvP2Twgx1o2A=="
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
        const currentUser = '@currentUser';
        const connection = new signalR.HubConnectionBuilder()
            .withUrl('/ChatHub')
            .withAutomaticReconnect()
            .build();

        let activeUser = null;
        let onlineUsers = [];
        const conversations = {};

        function setStatus(text, colorClass) {
            const status = document.getElementById('connectionStatus');
            status.textContent = text;
            status.className = `badge ${colorClass}`;
        }

        function renderUsers(users) {
            onlineUsers = users;
            const list = document.getElementById('onlineUsers');
            list.innerHTML = '';

            const uniqueUsers = new Set(users.filter(u => u !== currentUser));
            Object.keys(conversations)
                .filter(u => u !== currentUser)
                .forEach(u => uniqueUsers.add(u));

            const others = Array.from(uniqueUsers).sort();
            if (others.length === 0) {
                list.innerHTML = '<li class="list-group-item text-muted">No other users online.</li>';
                return;
            }

            others.forEach(user => {
                const item = document.createElement('li');
                item.className = 'list-group-item d-flex justify-content-between align-items-center';
                item.textContent = user;
                item.role = 'button';
                item.onclick = () => selectUser(user);
                if (activeUser === user) {
                    item.classList.add('active');
                    item.classList.add('text-white');
                }
                list.appendChild(item);
            });
        }

        function selectUser(user) {
            activeUser = user;
            document.getElementById('activeUserLabel').textContent = `Chatting with ${user}`;
            renderConversation(user);
            renderUsers(onlineUsers);
        }

        function renderConversation(user) {
            const history = document.getElementById('chatHistory');
            history.innerHTML = '';
            const messages = conversations[user] || [];
            messages.forEach(msg => history.appendChild(createMessageBubble(msg)));
            history.scrollTop = history.scrollHeight;
        }

        function createMessageBubble({ sender, message, sentAt, isOwn }) {
            const wrapper = document.createElement('div');
            wrapper.className = `d-flex mb-2 ${isOwn ? 'justify-content-end' : 'justify-content-start'}`;

            const bubble = document.createElement('div');
            bubble.className = `p-3 rounded-3 ${isOwn ? 'bg-success text-white' : 'bg-light border'}`;
            bubble.innerHTML = `<div class="small text-muted">${sender}</div><div>${message}</div><div class="text-end small text-muted mb-0">${new Date(sentAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</div>`;

            wrapper.appendChild(bubble);
            return wrapper;
        }

        function addMessage(partner, sender, message, sentAt) {
            const chatPartner = partner || sender;
            const isOwn = sender === currentUser;
            const entry = { sender, message, sentAt, isOwn };
            conversations[chatPartner] = conversations[chatPartner] || [];
            conversations[chatPartner].push(entry);
            if (activeUser === chatPartner) {
                const history = document.getElementById('chatHistory');
                history.appendChild(createMessageBubble(entry));
                history.scrollTop = history.scrollHeight;
            }
        }

        connection.on('UsersUpdated', renderUsers);

        connection.on('ReceivePrivateMessage', (sender, message, sentAt, partner) => {
            addMessage(partner, sender, message, sentAt);
        });

        connection.start()
            .then(async () => {
                setStatus('Connected', 'bg-success');
                const users = await connection.invoke('GetOnlineUsers');
                renderUsers(users);
            })
            .catch(err => {
                console.error(err.toString());
                setStatus('Disconnected', 'bg-danger');
            });

        connection.onreconnecting(() => setStatus('Reconnecting...', 'bg-warning text-dark'));
        connection.onreconnected(() => setStatus('Connected', 'bg-success'));
        connection.onclose(() => setStatus('Disconnected', 'bg-danger'));

        document.getElementById('sendButton').addEventListener('click', sendMessage);
        document.getElementById('messageInput').addEventListener('keyup', (event) => {
            if (event.key === 'Enter') {
                sendMessage();
            }
        });

        function sendMessage() {
            const messageInput = document.getElementById('messageInput');
            const text = messageInput.value.trim();
            if (!activeUser) {
                alert('Select a user to chat with.');
                return;
            }
            if (!text) {
                return;
            }

            connection.invoke('SendPrivateMessage', activeUser, text)
                .catch(err => console.error(err.toString()));

            messageInput.value = '';
            messageInput.focus();
        }
    </script>
}
