@{
    ViewData["Title"] = "ChatPage";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            background-color: #e5ddd5;
            font-family: 'Roboto', sans-serif;
        }

        .chat-container {
            display: flex;
            flex-direction: column;
            height: 100vh;
        }

        .chat-header {
            background-color: #075e54;
            color: white;
            padding: 15px;
            font-size: 1.5rem;
        }

        .chat-body {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            background-color: #e5ddd5;
        }

        .chat-footer {
            background-color: #f0f0f0;
            padding: 10px;
        }

        .message-bubble {
            background-color: #dcf8c6;
            border-radius: 7.5px;
            padding: 10px;
            margin-bottom: 10px;
            max-width: 75%;
            position: relative;
        }

        .message-meta {
            font-size: 0.8rem;
            color: #555;
            margin-top: 5px;
        }

        .form-control:focus {
            box-shadow: none;
            border-color: #25d366;
        }

        #Conv {
            padding: 0;
            list-style: none;
        }

        #Conv li {
            width: 100%;
        }

        .sent-msg, .received-msg {
            max-width: 75%; /* control width */
            display: inline-block;
            padding: 10px 15px;
            border-radius: 15px;
            background-color: rgba(220, 248, 198, 0.8); /* WhatsApp-like green (for sent) */
            word-wrap: break-word;
            box-shadow: 0 1px 2px rgba(0,0,0,0.1);
        }

        .sent-msg {
            background-color: rgba(37, 211, 102, 0.7); /* WhatsApp green */
            color: white;
            border-bottom-right-radius: 0;
        }

        .received-msg {
            background-color: rgba(240, 240, 240, 0.9);
            color: black;
            border-bottom-left-radius: 0;
        }
    </style>
</head>
<body>
    <div class="chat-container">
        <div class="chat-header">Chat Room</div>
        <div class="chat-body d-flex flex-column" id="chatBox">
            <ul id="Conv" class="d-flex flex-column gap-2"></ul>
        </div>        
        <div class="chat-footer">
            <div class="input-group">
                <input type="text" id="Name" class="form-control me-2" placeholder="Your Name" style="max-width: 200px;">
                <input type="text" id="Msg" class="form-control" placeholder="Type a message..." />
                <button class="btn btn-success ms-2" onclick="SendData()">Send</button>
            </div>
        </div>
    </div>

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"
        integrity="sha512-7SRCYIJtR6F8ocwW7UxW6wGKqbSyqREDbfCORCbGLatU0iugBLwyOXpzhkPyHIFdBO0K2VCu57fvP2Twgx1o2A=="
        crossorigin="anonymous" referrerpolicy="no-referrer"></script>

    <script>
        const hub = new signalR.HubConnectionBuilder().withUrl("/ChatHub").build();

        function scrollToBottom() {
            const chatBox = document.getElementById("chatBox");
            chatBox.scrollTop = chatBox.scrollHeight;
        }

        function getTime() {
            const now = new Date();
            return now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        }

        hub.on("NewMessageNotify", function (name, message) {
            const currentUser = $("#Name").val().trim();
            const isOwnMessage = (name === currentUser);

            let msgHtml = `
                <li class="mb-2 d-flex ${isOwnMessage ? 'justify-content-end' : 'justify-content-start'}">
                    <div class="${isOwnMessage ? 'sent-msg' : 'received-msg'}">
                        <div class="fw-bold">${name}</div>
                        <div>${message}</div>
                        <div class="text-end small text-muted mt-1">${getTime()}</div>
                    </div>
                </li>
            `;
            $("#Conv").append(msgHtml);
            scrollToBottom();
        });


        hub.start().then(() => {
            console.log("Connected to SignalR hub.");
        }).catch(err => {
            console.error("Connection failed: ", err.toString());
        });

        function SendData() {
            const name = $("#Name").val().trim();
            const message = $("#Msg").val().trim();

            if (!name || !message) {
                alert("Please enter both name and message.");
                return;
            }

            hub.invoke("NewMessage", name, message).catch(err => console.error(err.toString()));
            $("#Msg").val('').focus();
        }

        $("#Msg").keypress(function (e) {
            if (e.which === 13) {
                SendData();
            }
        });
    </script>
</body>
</html>
